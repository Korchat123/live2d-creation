{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-avatar.dev/schema/control-envelope/1.0",
  "title": "Open Avatar Control Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "id", "type"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
    },
    "id": { "$ref": "#/$defs/id" },
    "type": {
      "enum": [
        "capability.query",
        "control.set",
        "action.play",
        "command.cancel",
        "control.reset"
      ]
    },
    "timestamp": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {},
    "delivery": {}
  },
  "oneOf": [
    {
      "properties": { "type": { "const": "capability.query" } },
      "not": {
        "anyOf": [{ "required": ["payload"] }, { "required": ["delivery"] }]
      }
    },
    {
      "required": ["payload", "delivery"],
      "properties": {
        "type": { "const": "control.set" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel", "x", "y"],
              "properties": {
                "channel": { "const": "gaze" },
                "x": { "type": "number", "minimum": -1, "maximum": 1 },
                "y": { "type": "number", "minimum": -1, "maximum": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel", "value"],
              "properties": {
                "channel": { "const": "mouthOpen" },
                "value": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          ]
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "key", "supersedesPending"],
          "properties": {
            "mode": { "const": "coalesce" },
            "key": { "enum": ["gaze", "mouthOpen"] },
            "supersedesPending": { "const": true }
          }
        }
      }
    },
    {
      "required": ["payload"],
      "properties": {
        "type": { "const": "action.play" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action"],
              "properties": { "action": { "const": "blink" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "contentId"],
              "properties": {
                "action": { "enum": ["expression", "motion", "pose"] },
                "contentId": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      },
      "not": { "required": ["delivery"] }
    },
    {
      "required": ["payload"],
      "properties": {
        "type": { "const": "command.cancel" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commandId"],
          "properties": { "commandId": { "$ref": "#/$defs/id" } }
        }
      },
      "not": { "required": ["delivery"] }
    },
    {
      "properties": { "type": { "const": "control.reset" } },
      "not": {
        "anyOf": [{ "required": ["payload"] }, { "required": ["delivery"] }]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
