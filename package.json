{
  "name": "open-2d-avatar",
  "version": "0.0.0",
  "private": true,
  "description": "A provider-neutral, browser-based 2D avatar runtime and toolchain.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "ci": "npm run safety:check && npm run rights:check && npm run rights:test && npm run requirements:check && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:tools && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:dry-run": "node tools/package-dry-run.mjs",
    "requirements:check": "node tools/check-requirements-traceability.mjs",
    "rights:check": "node tools/validate-rights.mjs",
    "rights:test": "node --test tests/rights/*.test.mjs",
    "safety:check": "node tools/check-repository-safety.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
