{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-avatar.dev/schema/manifest/1.0",
  "title": "Open Avatar Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "canvas",
    "assets",
    "parameters",
    "capabilities"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
    },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "const": "image" },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[\\\\])[A-Za-z0-9._/-]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "min", "max", "default"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "min": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "max": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "default": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expression": { "$ref": "#/$defs/capability" },
        "motion": { "$ref": "#/$defs/capability" },
        "gaze": { "$ref": "#/$defs/capability" },
        "blink": { "$ref": "#/$defs/capability" },
        "mouthOpen": { "$ref": "#/$defs/capability" },
        "pose": { "$ref": "#/$defs/capability" },
        "reset": { "$ref": "#/$defs/capability" },
        "reducedMotion": { "$ref": "#/$defs/capability" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "capability": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/id" },
              "uniqueItems": true
            }
          }
        }
      ]
    }
  }
}
