{
  "name": "open-2d-avatar",
  "version": "0.0.0",
  "private": true,
  "description": "A provider-neutral, browser-based 2D avatar runtime and toolchain.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "ci": "npm run safety:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:dry-run": "node tools/package-dry-run.mjs",
    "safety:check": "node tools/check-repository-safety.mjs",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
