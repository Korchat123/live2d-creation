{
  "extends": "../../tools/tsconfig.package.json",
  "compilerOptions": {
    "composite": false,
    "outDir": "dist",
    "rootDir": "../..",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@open-avatar/core": ["../../packages/core/src/index.ts"],
      "@open-avatar/renderer-pixi": [
        "../../packages/renderer-pixi/src/index.ts"
      ],
      "@open-avatar/schema": ["../../packages/schema/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/renderer-pixi/src/**/*.ts",
    "../../packages/schema/src/**/*.ts"
  ]
}
